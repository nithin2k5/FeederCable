# Legacy C# codebase (reference only)
Feeder Cable (2)/

# Python
__pycache__/
*.pyc

# Per-lot vision pass images -- operational data, one file per test run
vision_captures/

# Runtime scratch for the START/END marker labels (rendered from MARKER.prn)
TEMPMARKER_*.prn

# Runtime scratch for the lot (box) label (rendered from LOTPRN.prn)
TEMPLOTPRN.prn

# PyInstaller build output and the build virtualenv (see install.sh)
.venv/
build/
dist/
FeederCable.spec
.install.lock/
.build.stamp

# Native crash traces written by faulthandler (see main.py)
crash.log

# Wire colours set up on the station (per part) -- station data, like the
# vision captures; a pull must not overwrite what was set up there
vision_wires.json
vision_wires.json.tmp
